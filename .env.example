# ClipCal — env template. Copy to .env.local and fill in.

# --- Anthropic (existing) ---
ANTHROPIC_API_KEY=

# --- Supabase ---
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, NEVER shipped to the client.
# Only imported by lib/supabase/admin.ts (enforced by ESLint).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (for local `supabase start`; production is set in dashboard) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
